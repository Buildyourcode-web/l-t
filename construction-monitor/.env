# ── Application ────────────────────────────────────────────
APP_TITLE=Construction Site AI Monitor
APP_VERSION=1.0.0
DEBUG=false

# ── Database ───────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=construction_monitor
DB_USER=postgres
DB_PASSWORD=postgres

# ── AI Models ──────────────────────────────────────────────
MODEL_PPE_PATH=models/ppe.pt
MODEL_FIRE_PATH=models/fire.pt
MODEL_DEVICE=0
MODEL_CONF_THRESHOLD=0.45
MODEL_IOU_THRESHOLD=0.45

# ── PPE Classes to monitor (extensible) ────────────────────
VIOLATION_CLASSES=helmet,vest
PPE_CLASS_NAMES=boots,gloves,helmet,human,vest
PERSON_CLASS_NAME=human

# ── Camera & Detection ─────────────────────────────────────
CAMERAS_CONFIG_PATH=config/cameras.json
DETECTION_FPS=2
FRAME_QUEUE_SIZE=10
RTSP_RECONNECT_DELAY=5
CAMERA_WATCHDOG_TIMEOUT=10

# ── Tracking & Alerts ──────────────────────────────────────
ALERT_COOLDOWN_SECONDS=30
TRACK_CLEANUP_INTERVAL_SECONDS=300
TRACK_EXPIRY_SECONDS=60

# ── Screenshot Storage ─────────────────────────────────────
SCREENSHOT_DIR=screenshots
SCREENSHOT_QUALITY=85

# ── Reports ────────────────────────────────────────────────
REPORTS_DIR=reports
REPORTS_RETENTION_DAYS=90
SCREENSHOTS_RETENTION_DAYS=90

# ── Logging ────────────────────────────────────────────────
LOG_DIR=logs
LOG_LEVEL=INFO

# ── API ────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
